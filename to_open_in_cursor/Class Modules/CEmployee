End Property

Public Property Get SurnameModerated() As String
    Tag = textInSquareBrackets(Me.Surname)
    If Tag <> "" Then
        SurnameModerated = Replace(Me.Surname, Tag, "")
    Else
        SurnameModerated = Me.Surname
    End If
End Property

Public Property Let Surname(Value As String)
    eSurname = Value
End Property

Public Property Get Name() As String
