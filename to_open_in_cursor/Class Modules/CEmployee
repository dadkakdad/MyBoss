'Return direct reports separated by type of reporting
Public Property Get DirectReports(ByVal sortRegime As String) As Object
    'Initialize storage for organised direct reports
    Set MyDictionaryDirectReportsClassified = New Dictionary
    
    MyDictionaryDirectReportsClassified.add "All", New Collection
    MyDictionaryDirectReportsClassified.add "Solid", New Collection
    MyDictionaryDirectReportsClassified.add "Dotted", New Collection
    MyDictionaryDirectReportsClassified.add "Workers", New Collection
    MyDictionaryDirectReportsClassified.add "Managers", New Collection
    
    If MyDictionaryDirectReports.Item(Me.FullNameKey).Count > 0 Then
        With MyDictionaryDirectReportsClassified
            Set directReportsBuffer = New Collection
            
            If LCase(sortRegime) = "sorted" Then
                Dim directReportsNotClassified() As Variant
                
                'Create instance to store direct reports in Variant
                ReDim directReportsNotClassified(MyDictionaryDirectReports.Item(Me.FullNameKey).Count - 1)
                        
                'Copy values from Collection to Variant for easier sorting (you can't swap values in Collection)
                For i = 0 To UBound(directReportsNotClassified, 1)
                    directReportsNotClassified(i) = MyDictionaryDirectReports.Item(Me.FullNameKey)(i + 1)
                Next i
                
                'Select whether you want a sorted array or not
                Call sortUtility(directReportsNotClassified, 0, UBound(directReportsNotClassified), "maturity", False)
                
                For i = 0 To UBound(directReportsNotClassified, 1)
                    directReportsBuffer.add directReportsNotClassified(i)
                Next i
            Else
                Set directReportsBuffer = MyDictionaryDirectReports.Item(Me.FullNameKey)
            End If
            
            'Loop through direct reports, separate them by category
            For Each directReport In directReportsBuffer
                'Separate by reporting type
                .Item("All").add directReport
                .Item(MyDictionaryPersonalInfo.Item(directReport).ManagerType(Me.FullNameKey)).add directReport
                            
                'Separate by status (manager OR worker)
                If MyDictionaryPersonalInfo.Item(directReport).IsManager Then
                    .Item("Managers").add directReport
                Else
                    .Item("Workers").add directReport
                End If
            Next directReport
        End With
    End If

    Set DirectReports = MyDictionaryDirectReportsClassified
End Property

'Returns the list of departments with people inside
'WE ALWAYS HAVE AT LEAST ONE DEPARTMENT
Public Property Get ListOfDepartments(ByVal directReportsClass As String) As Dictionary
    'Initialize storage for organized direct reports
    Set ListOfDepartments = New Dictionary

    'Distribute non-managerial direct reports from sublist to departments and save distribution to MyDictionaryDepartmentsList
    For Each directReport In Me.DirectReports("Sorted").Item(directReportsClass)
        DepartmentName = MyDictionaryPersonalInfo.Item(directReport).DepartmentKey
        If DepartmentName = "" Then DepartmentName = "<no_department_specified>"
                    
        If Not ListOfDepartments.Exists(DepartmentName) Then ListOfDepartments.add DepartmentName, New Collection
        ListOfDepartments.Item(DepartmentName).add directReport
    Next directReport
End Property
