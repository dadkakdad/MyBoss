'---------- COMPLEX METHODS ---------
'Manager is a person with at least one direct report
Public Property Get IsManager() As Boolean
    If MyDictionaryDirectReports.Item(Me.FullNameKey).Count > 0 Then
        IsManager = True
    Else
        IsManager = False
    End If
End Property

'Worker is a person with no direct reports
Public Property Get IsWorker() As Boolean
    IsWorker = Not (IsManager)
End Property

'"To Be Hired" is a person which is not added to headcount when calculating total number of subordinates
Public Property Get IsToBeHired() As Boolean
    'To Be Hired people are identified by their names: TBH_SE, TBH_DD, etc.
    If startsWith(Me.FullName, "TBH_") Then
        IsToBeHired = True
    Else
        IsToBeHired = False
    End If
End Property

'Check if person has both solid- and dotted- line managers;
Public Property Get HasTwoManagers() As Boolean
    'He should have solid-line manager by default, so it's enough to check whether he has dotted-line one
    If Me.FullNameDottedLineManagerKey = "" Then
        HasTwoManagers = False
    Else
        HasTwoManagers = True
    End If
End Property

'Check who is personFullName - Solid, Dotted or None of these two
Public Property Get ManagerType(ByVal personFullName As String) As String
    Select Case personFullName
        Case Me.FullNameSolidLineManagerKey
            ManagerType = "Solid"
        Case Me.FullNameDottedLineManagerKey
            ManagerType = "Dotted"
        Case Else
            ManagerType = ""
    End Select
End Property

        
'Mirrors "getReferenceTickNames' logic
Public Property Get nOrdinaryBranchesUtil(ByVal considerAllDirectReportsAsWorkers As Boolean) As Integer
    If considerAllDirectReportsAsWorkers Then
        nOrdinaryBranchesUtil = 0
    Else
        nOrdinaryBranchesUtil = Me.DirectReports("Unsorted").Item("Managers").Count
    End If
End Property

Public Property Get nDepartmentBranchesUtil(ByVal considerAllDirectReportsAsWorkers As Boolean) As Integer
    If considerAllDirectReportsAsWorkers Then
        nDepartmentBranchesUtil = Me.ListOfDepartments("All").Count
    Else
        nDepartmentBranchesUtil = Me.ListOfDepartments("Workers").Count
    End If
End Property

Public Property Get nBranchesHorizontallyLimitExceeded(ByVal considerAllDirectReportsAsWorkers As Boolean) As Integer
    nOrdinaryBranches = Me.nOrdinaryBranchesUtil(considerAllDirectReportsAsWorkers)
    nDepartmentBranches = Me.nDepartmentBranchesUtil(considerAllDirectReportsAsWorkers)
    
    If (nOrdinaryBranches + nDepartmentBranches) > MAX_BRANCHES_HORIZONTALLY Then
        nBranchesHorizontallyLimitExceeded = True
    Else
        nBranchesHorizontallyLimitExceeded = False
    End If
End Property



