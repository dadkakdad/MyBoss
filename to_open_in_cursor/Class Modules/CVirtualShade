'Visualize the area occupied by virtual rectangle
Public Sub visualizeColorful(ByVal slideNumber As Integer)
    With ActivePresentation.Slides(slideNumber).Shapes.AddShape(msoShapeRectangle, Me.LeftBorder, Me.TopBorder, Me.Width, Me.Height).Fill
        .ForeColor.RGB = RGB(wfRandomIntegerInRange(0, 255), wfRandomIntegerInRange(0, 255), wfRandomIntegerInRange(0, 255))
    End With
End Sub

