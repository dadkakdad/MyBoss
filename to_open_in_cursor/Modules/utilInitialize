Function getRibbon() As IRibbonUI
    Set getRibbon = RibbonObj()
End Function

Sub MyAddInInitialize(Ribbon As IRibbonUI)
    Err.Clear
    'stopExecutionFlag = False

    Call RibbonOnLoad(Ribbon)
    
    'Important for automatic card detection
    Set X.PPTEvent = Application
    
    Set MyDictionaryPersonalInfo = New Dictionary
    
    Set MyDictionaryDirectReports = New Dictionary
    
    Set MyDictionaryEmployeesPerCategory = New Dictionary
    
    Set MyDictionaryCardsCheckList = New Dictionary
    Set MyDictionaryCeoCandidates = New Dictionary
    Set MyDictionaryDepartmentsList = New Dictionary
    
    Set MyDictionarySubordinatesChecklist = New Dictionary
    
    fileUploadingSuccessful = False
    fileSelectionSuccessful = False
    
    sheetHasTitlesFlag = True
    
    addSlideNEnabledFlag = False
    
    ungroupShapesEnabledFlag = False
    groupShapesEnabledFlag = False
    
    autodetectSizeAndWhiteSpaceFlag = True
    dropDownBoxSizeEnabledFlag = True
    dropDownWhiteSpaceEnabledFlag = True
    
    shadeIterator = 1
    orgchartElementToCreate = 0
    orgchartElementCreatedCounter = 0
    
    'Name convention for card sizes
    Set MyDictionaryCardSizes = New Collection
    With MyDictionaryCardSizes
        .add "ExtraSmall"
        .add "Small"
        .add "Medium"
        .add "Large"
    End With
    
    'Name convention for tick lengths
    Set MyDictionaryTickLengths = New Collection
    With MyDictionaryTickLengths
        .add 5
        .add 7
        .add 10
        .add 12
        .add 15
    End With
    
    'Default OC creator settings
    Call initPalette
    Call findFullPalette
    MsgBox ("WELCOME TO THE ORG CHART CREATOR!" & vbCrLf & _
                    "Full templates palette is on slide " & paletteSlideNumber & "." & vbCrLf & _
                    "Have a good day :)")
    
    defaultNumberOfShades = 3
    defaultHomeCity = "Russia, Moscow"
    defaultInputNumberOfColumns = 13
    
    'Safe zone dimensions
    On Error Resume Next
    const_slideTopBorder = 140#
    const_slideRightBorder = 945#
    const_slideBottomBorder = 505#
    const_slideLeftBorder = 15#
    On Error GoTo 0
    
    'Parameters for tree size optimizer
    maxWidthGuideline = 920
    maxHeightGuideline = 350
    
    MAX_PEOPLE_FOR_2D_BRANCH = 6
    MAX_PEOPLE_FOR_4D_BRANCH = 14
    MAX_BRANCHES_HORIZONTALLY = 7
    
    ReDim MyVariantListOfSheets(0)
End Sub
