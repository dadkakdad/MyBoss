Sub createOrgChartElement(ByVal slideNumber As Integer, ByVal personFullName As String, ByVal ManagerType As String, ByVal X As Double, ByVal Y As Double, ByVal tickDirection)
    With ActivePresentation.Slides(slideNumber)
        'start building the shape
        ticShapesCounter = .Shapes.Count
        
        'Add tiny connector to the orgtree
        shapeToCreateName = personFullName & "Tick"
        Select Case tickDirection
            Case 1 'pointing UP
                tickLength = inputWhiteSpaceY
                If MyDictionaryPersonalInfo.Item(personFullName).HasTwoManagers Then tickLength = tickLength + getBubbleHeight() + bubbleClearance()
                
                Call drawLineVertical(slideNumber, shapeToCreateName, getCardWidth() / 2, 0, -tickLength, ManagerType)
            Case 2 'pointing RIGHT
                Call drawLineHorizontal(slideNumber, shapeToCreateName, getCardWidth(), getCardHeight / 2, inputWhiteSpaceX, ManagerType)
            Case 3 'pointing DOWN
                Call drawLineVertical(slideNumber, shapeToCreateName, getCardWidth() / 2, getCardHeight, inputWhiteSpaceY, ManagerType)
            Case 4 'pointing LEFT
                Call drawLineHorizontal(slideNumber, shapeToCreateName, 0, getCardHeight / 2, -inputWhiteSpaceX, ManagerType)
        End Select
            
        'add link to additional manager (additional tick)
        If MyDictionaryPersonalInfo.Item(personFullName).HasTwoManagers Then
            'Pill sits fully above the card. The stub stops at the pill's lower edge
            'so the connector does not strike through the manager surname.
            bubbleTop = -(getBubbleHeight() + bubbleClearance())
            
            shapeToCreateName = personFullName & "Manager" & "Tick" & inverseType(ManagerType)
            If tickDirection = 1 Then
                Call drawLineVertical(slideNumber, shapeToCreateName, getCardWidth() / 2 + 5, 0, bubbleTop + getBubbleHeight(), inverseType(ManagerType))
            Else
                Call drawLineVertical(slideNumber, shapeToCreateName, getCardWidth() / 2, 0, bubbleTop + getBubbleHeight(), inverseType(ManagerType))
            End If
            
            additionalManagerFullNameKey = MyDictionaryPersonalInfo.Item(personFullName).ManagerByType(inverseType(ManagerType))
            
            'create bubble
            baldShapeName = copyShape(slideNumber, "Bubble", additionalManagerFullNameKey)
            'move bubble over the card, clear of both the card and the trunk
            Call moveShape(.Shapes(baldShapeName), getCardWidth() / 2 - getBubbleWidth() / 2, bubbleTop)
            'fill it with proper info
            Call fillBubble(.Shapes(baldShapeName), additionalManagerFullNameKey, inverseType(ManagerType))
            'give it a proper name
            .Shapes(baldShapeName).Name = personFullName & "Manager" & "Bubble" & inverseType(ManagerType)
        End If
        
        'add comment box with termination date
        If MyDictionaryPersonalInfo.Item(personFullName).TerminationDate <> "" Then
            'create comment box
            baldShapeName = copyShape(slideNumber, "commentBox")
            'leave a gap under the location line so the date does not cover it
            Call moveShape(.Shapes(baldShapeName), 0, getCardHeight() + commentClearance())
            'fill it with proper info
            Call fillCommentBox(.Shapes(baldShapeName), personFullName)
            'give it a proper name
            .Shapes(baldShapeName).Name = personFullName & "CommentBox" & ManagerType
        End If
                
        'create card
        baldShapeName = copyShape(slideNumber, "Card", personFullName)
        'move card to top left corner
        Call moveShape(.Shapes(baldShapeName), 0, 0)
        'fill it with proper info
        Call fillCard(.Shapes(baldShapeName), personFullName)
        'call this new card like "<personFullName>Card" and mark it
        .Shapes(baldShapeName).Name = personFullName & "Card"
        
        'add marker to primitives' names
        Call addMarkerToShape(.Shapes(personFullName & "Tick"), ManagerType)
        Call addMarkerToAllShapeElements(.Shapes(personFullName & "Card"), ManagerType)
            
        tocShapesCounter = .Shapes.Count
            
        'Group all the shapes created
        Call groupAllShapesInIndexList(slideNumber, ticShapesCounter, tocShapesCounter, personFullName & ManagerType)
            
        'move the element so that tick apex touches (originX, originY)
        Call moveShape(.Shapes(personFullName & ManagerType), X, Y)
            
        Dim tickApexDx, tickApexDy As Integer
        With checkShapeExists(slideNumber, personFullName & "Tick" & ManagerType)
                Select Case tickDirection
                    Case 1, 4
                        tickApexDx = .Left - X
                        tickApexDy = .Top - Y
                    Case 2, 3
                        tickApexDx = .Left + .Width - X
                        tickApexDy = .Top + .Height - Y
                End Select
        End With
            
        Call moveShape(.Shapes(personFullName & ManagerType), X - tickApexDx, Y - tickApexDy)

        'select the just created element
        If ActiveWindow.Selection.SlideRange.slideIndex <> slideNumber Then
            ActiveWindow.View.GotoSlide index:=slideNumber
        End If
        
        .Shapes(personFullName & ManagerType).Select
    End With
    
    '-1 for created element
    orgchartElementCreatedCounter = orgchartElementCreatedCounter + 1
    Call updateProgressBar(orgchartElementCreatedCounter / orgchartElementToCreate)
    
'    wTemp = ActiveWindow.Selection.SlideRange.Shapes(personFullName & ManagerType).Width
'    hTemp = ActiveWindow.Selection.SlideRange.Shapes(personFullName & ManagerType).Height
'
'    MsgBox (personFullName & ManagerType & vbCrLf & "--- Size Card ---" & vbCrLf & _
'    "tickDirection: " & tickDirection & vbCrLf & _
'    "w: " & Int(wTemp) & "(as is) VS " & Int(sizeOfOrgChartElement(personFullName, tickDirection).tWidth) & "(calc)" & vbCrLf & _
'    "h: " & Int(hTemp) & "(as is) VS " & Int(sizeOfOrgChartElement(personFullName, tickDirection).tHeight) & "(calc)")
End Sub

Function sizeOfOrgChartElement(ByVal personFullName As String, ByVal tickDirection As Integer) As CTreeSize
    Dim orgChartElementSize As CTreeSize
    Set orgChartElementSize = New CTreeSize
    
    With orgChartElementSize
        'account for card
        .tWidth = getCardWidth()
        .tHeight = getCardHeight()
        
        'account for tick (zero tick thickness approximation)
        Select Case tickDirection
            Case 1 'UP
                'account for tick
                .tWidth = .tWidth + 0
                .tHeight = .tHeight + inputWhiteSpaceY
                
                'account for bubble, including the gap that keeps it off the card
                 If MyDictionaryPersonalInfo.Item(personFullName).HasTwoManagers() Then .tHeight = .tHeight + getBubbleHeight() + bubbleClearance()
                 
                 'account for comment box and the gap under the location line
                 If MyDictionaryPersonalInfo.Item(personFullName).TerminationDate <> "" Then .tHeight = .tHeight + getCommentBoxHeight() + commentClearance()
            Case 4 'LEFT
                'account for tick
                .tWidth = .tWidth + inputWhiteSpaceX
                .tHeight = .tHeight + 0
                
                'account for bubble
                 If MyDictionaryPersonalInfo.Item(personFullName).HasTwoManagers() Then .tHeight = .tHeight + getBubbleHeight() + bubbleClearance()
                 
                 'account for comment box
                 If MyDictionaryPersonalInfo.Item(personFullName).TerminationDate <> "" Then .tHeight = .tHeight + getCommentBoxHeight() + commentClearance()
        End Select
    End With
    Set sizeOfOrgChartElement = orgChartElementSize
End Function

Sub fillCard(ByRef shapeObject As Shape, ByVal personFullName As String)
    With shapeObject
        tempSurname = MyDictionaryPersonalInfo.Item(personFullName).SurnameModerated
        tempName = MyDictionaryPersonalInfo.Item(personFullName).NameModerated
        tempJobTitle = MyDictionaryPersonalInfo.Item(personFullName).JobTitle
        
        If MyDictionaryPersonalInfo.Item(personFullName).IsToBeHired Then
            .GroupItems("InfoBox").TextFrame.TextRange.Text = "To Be Hired" & Chr(10) & " " & tempJobTitle
        Else
            If inputBoxSize <> "ExtraSmall" Then
                .GroupItems("InfoBox").TextFrame.TextRange.Text = tempSurname & vbCr & tempName & vbCr & tempJobTitle
            Else
                .GroupItems("InfoBox").TextFrame.TextRange.Text = tempSurname & vbCr & tempName & vbCr
            End If
        End If
        
        Select Case inputBoxSize
            Case "ExtraSmall"
                tempFullNameFontSize = 7
                tempJobTitleFontSize = 4
            Case "Small"
                tempFullNameFontSize = 7
                tempJobTitleFontSize = 4
            Case "Medium"
                tempFullNameFontSize = 9
                tempJobTitleFontSize = 5
            Case "Large"
                tempFullNameFontSize = 11
                tempJobTitleFontSize = 6
        End Select
        
        With .GroupItems("InfoBox").TextFrame.TextRange.Paragraphs(1, 2).Font
            .Size = tempFullNameFontSize
            .Bold = True
        End With
        
        If MyDictionaryPersonalInfo.Item(personFullName).IsToBeHired Then
            With .GroupItems("InfoBox").TextFrame.TextRange.Paragraphs(2).Font
                .Size = tempJobTitleFontSize
                .Bold = False
            End With
        Else
            With .GroupItems("InfoBox").TextFrame.TextRange.Paragraphs(3).Font
                .Size = tempJobTitleFontSize
                .Bold = False
            End With
        End If
        
        'HeadCount Design
        tempSubordinatesAll = MyDictionaryPersonalInfo.Item(personFullName).HeadcountStats.SubordinatesNumber
        tempSubordinatesOutsourcers = MyDictionaryPersonalInfo.Item(personFullName).HeadcountStats.OutsourceNumber
        If tempSubordinatesOutsourcers > 0 Then
            tempConcatenated = CStr(tempSubordinatesAll) & " (" & tempSubordinatesOutsourcers & ")"
        Else
            tempConcatenated = CStr(tempSubordinatesAll)
        End If
        
        With .GroupItems("HeadCount").TextFrame.TextRange
            .Text = CStr(tempConcatenated)
            .Font.Bold = True
        End With
            
        If tempSubordinatesAll <= 1 Then
             .GroupItems("HeadCount").Visible = False
        End If
        
        
            'Location Design
            tempLocation = MyDictionaryPersonalInfo.Item(personFullName).Location
            
            'If location is specified
            If StrComp(Trim(CStr(tempLocation)), "") = 0 Then
                .GroupItems("BottomBackground").Visible = False
                .GroupItems("Location").Visible = False
                
                tempOutsourceFlag = MyDictionaryPersonalInfo.Item(personFullName).OutsourceFlag
                tempImportantFlag = MyDictionaryPersonalInfo.Item(personFullName).ImportantFlag
                If (CInt(tempImportantFlag) = 0 And CInt(tempOutsourceFlag) = 0) Or (CInt(tempImportantFlag) = -1) Then
                    With .GroupItems("HeadCount").TextFrame.TextRange.Font
                        .Color.RGB = RGB(255, 255, 255)
                    End With
                End If
            Else
                .GroupItems("Location").TextFrame.TextRange.Text = tempLocation
            End If
            
        'Pin headcount and location into the footer so they cannot cover the name
        Call arrangeCardFooter(shapeObject)
            
            .GroupItems("Location").Name = personFullName & "Location"
            .GroupItems("BottomBackground").Name = personFullName & "BottomBackground"
        
        .GroupItems("InfoBox").Name = personFullName & "InfoBox"
        .GroupItems("HeadCount").Name = personFullName & "HeadCount"
        .GroupItems("MainBackground").Name = personFullName & "MainBackground"
    End With
End Sub

Sub fillBubble(ByRef shapeObject As Shape, ByVal additionalManagerFullNameKey As String, ByVal ManagerType As String)
    'Navy pill with white type. Shrink the surname if it is wider than the pill.
    With shapeObject.TextFrame.TextRange
        .Text = MyDictionaryPersonalInfo.Item(additionalManagerFullNameKey).Surname
        .Font.Bold = True
        .Font.Color.RGB = RGB(255, 255, 255)
    End With
    
    shapeObject.Fill.Visible = msoTrue
    shapeObject.Fill.Solid
    shapeObject.Fill.ForeColor.RGB = RGB(0, 27, 87)
    shapeObject.Fill.Transparency = 0
    
    On Error Resume Next
    shapeObject.TextFrame.WordWrap = msoFalse
    shapeObject.TextFrame2.WordWrap = msoFalse
    shapeObject.TextFrame2.AutoSize = 2 'msoAutoSizeTextToFitShape
    On Error GoTo 0
    
    Call applyLineStyle(shapeObject, ManagerType, 3)
End Sub

Sub fillCommentBox(ByRef shapeObject As Shape, ByVal personFullName As String)
    Dim commentText As String
    Dim commentFontSize As Double
    
    terminationDateText = MyDictionaryPersonalInfo.Item(personFullName).TerminationDate
    If InStr(1, terminationDateText, "at") > 0 Then
        terminationDateText = Trim(Left(terminationDateText, InStr(1, terminationDateText, "at") - 1))
        terminationDateText = Trim(Right(terminationDateText, Len(terminationDateText) - InStr(1, terminationDateText, ",") - 1))
    End If
    
    commentText = "Works until"
    If Len(terminationDateText) > 0 Then
        If IsDate(terminationDateText) Then
            commentText = "Works until " & Format(CDate(terminationDateText), "d mmmm yyyy")
        Else
            commentText = terminationDateText
        End If
    End If
    
    Select Case inputBoxSize
        Case "ExtraSmall", "Small"
            commentFontSize = 7
        Case "Medium"
            commentFontSize = 8
        Case "Large"
            commentFontSize = 9
        Case Else
            commentFontSize = 8
    End Select
    
    'Opaque light pill. A transparent one lets the card underneath show through the date.
    With shapeObject
        .Fill.Visible = msoTrue
        .Fill.Solid
        .Fill.ForeColor.RGB = RGB(255, 255, 255)
        .Fill.Transparency = 0
        .Line.Visible = msoTrue
        .Line.ForeColor.RGB = RGB(0, 32, 96)
        .Line.Weight = 0.75
    End With
    
    With shapeObject.TextFrame
        .WordWrap = msoTrue
        .AutoSize = ppAutoSizeNone
        .MarginLeft = 2
        .MarginRight = 2
        .MarginTop = 0
        .MarginBottom = 0
        With .TextRange
            .Text = commentText
            .Font.Bold = True
            .Font.Color.RGB = RGB(0, 32, 96)
            .Font.Size = commentFontSize
            .ParagraphFormat.Alignment = ppAlignCenter
        End With
    End With
    
    On Error Resume Next
    shapeObject.TextFrame2.WordWrap = msoTrue
    shapeObject.TextFrame2.AutoSize = 2 'shrink onto the pill if the date is long
    On Error GoTo 0
End Sub

'Gap between a dotted-line surname pill and the card under it
Function bubbleClearance() As Double
    bubbleClearance = getLineWeight() + 4
End Function

'Gap between a card's location line and its "works until" note
Function commentClearance() As Double
    commentClearance = 4
End Function

'Keep the name block, the location and the headcount in their own bands
Sub arrangeCardFooter(ByRef shapeObject As Shape)
    Dim cardLeft As Double
    Dim cardTop As Double
    Dim cardWidth As Double
    Dim cardHeight As Double
    Dim barHeight As Double
    Dim footerTop As Double
    Dim hcWidth As Double
    Dim barRGB As Long
    Dim luminance As Double
    Dim textRGB As Long
    
    cardLeft = shapeObject.Left
    cardTop = shapeObject.Top
    cardWidth = shapeObject.Width
    cardHeight = shapeObject.Height
    barHeight = shapeObject.GroupItems("BottomBackground").Height
    If barHeight < 1 Then Exit Sub
    footerTop = cardTop + cardHeight - barHeight
    
    With shapeObject.GroupItems("BottomBackground")
        .Left = cardLeft
        .Top = footerTop
        .Width = cardWidth
    End With
    
    hcWidth = cardWidth * 0.4
    If hcWidth < 26 Then hcWidth = 26
    If hcWidth > cardWidth * 0.48 Then hcWidth = cardWidth * 0.48
    
    With shapeObject.GroupItems("Location")
        .Left = cardLeft
        .Top = footerTop
        .Width = cardWidth - hcWidth
        .Height = barHeight
    End With
    
    With shapeObject.GroupItems("HeadCount")
        .Left = cardLeft + cardWidth - hcWidth
        .Top = footerTop
        .Width = hcWidth
        .Height = barHeight
    End With
    
    With shapeObject.GroupItems("InfoBox")
        If .Top < cardTop Then .Top = cardTop
        If .Top + .Height > footerTop - 1 Then
            .Height = footerTop - .Top - 1
        End If
        If .Height < 8 Then .Height = 8
        If .Width > cardWidth - 2 Then .Width = cardWidth - 2
    End With
    
    On Error Resume Next
    'Recolor only while the footer bar is showing. With no location the bar is hidden
    'and the headcount already sits in white on the card body.
    If shapeObject.GroupItems("BottomBackground").Visible Then
        barRGB = shapeObject.GroupItems("BottomBackground").Fill.ForeColor.RGB
        luminance = (barRGB Mod 256) * 0.299 + ((barRGB \ 256) Mod 256) * 0.587 + ((barRGB \ 65536) Mod 256) * 0.114
        If luminance < 140 Then
            textRGB = RGB(255, 255, 255)
        Else
            textRGB = RGB(0, 32, 96)
        End If
        shapeObject.GroupItems("Location").TextFrame.TextRange.Font.Color.RGB = textRGB
        shapeObject.GroupItems("HeadCount").TextFrame.TextRange.Font.Color.RGB = textRGB
    End If
    
    shapeObject.GroupItems("Location").TextFrame.WordWrap = msoFalse
    shapeObject.GroupItems("HeadCount").TextFrame.WordWrap = msoFalse
    shapeObject.GroupItems("Location").TextFrame2.AutoSize = 2
    shapeObject.GroupItems("HeadCount").TextFrame2.AutoSize = 2
    shapeObject.GroupItems("InfoBox").TextFrame.WordWrap = msoTrue
    shapeObject.GroupItems("InfoBox").TextFrame2.WordWrap = msoTrue
    shapeObject.GroupItems("InfoBox").TextFrame2.AutoSize = 2
    On Error GoTo 0
End Sub

'-----------------------------------------------------------
'----------- UTILITIES TO USE WITH ALL SHAPES --------------
'-----------------------------------------------------------

Function copyShape(ByVal slideNumber As Integer, ByVal shapeName As String, Optional ByVal personFullName As String = "") As String
    Dim tempTemplateName As String
    With MyDictionaryPersonalInfo.Item(personFullName)
        If personFullName <> "" Then
            If .IsToBeHired Then
                tempTemplateName = shapeName & "Tbh" & inputBoxSize
            Else
                If .ImportantFlag Then
                    tempTemplateName = shapeName & "Important" & inputBoxSize
                End If
                
                If .OutsourceFlag Then
                    tempTemplateName = shapeName & "Outsource" & inputBoxSize
                End If
                
                If (Not .ImportantFlag) And (Not .OutsourceFlag) Then
                    tempTemplateName = shapeName & "Ordinary" & inputBoxSize
                End If
            End If
        Else
            tempTemplateName = shapeName & inputBoxSize
        End If
    End With
    
    copyShape = copyShapeErrorFree(tempTemplateName, slideNumber, tempTemplateName)
End Function

Sub moveShape(ByRef shapeObject As Shape, ByVal X As Double, ByVal Y As Double)
    With shapeObject
        .Left = X
        .Top = Y
    End With
End Sub

Sub addMarkerToShape(ByRef shapeObject As Shape, ByVal marker As String)
    With shapeObject
        .Name = .Name & marker
    End With
End Sub

Sub addMarkerToAllShapeElements(ByRef shapeObject As Shape, ByVal marker As String)
    With shapeObject
        If .Type = msoGroup Then
            .Name = .Name & marker
            For X = 1 To .GroupItems.Count
                .GroupItems(X).Name = .GroupItems(X).Name & marker
            Next X
        Else
            .Name = .Name & marker
        End If
    End With
End Sub

