'--------- INPUT FILE NAME ---------
Sub uiShowInputFileName(control As IRibbonControl, ByRef returnedVal)
    Select Case (control.id)
        Case "inputFileName"
            If StrComp(inputFilePath, "") <> 0 Then
                returnedVal = inputFileName
            Else
                inputFilePath = returnedVal
            End If
    End Select
End Sub

Sub uiCopyFileNameToScreentip(control As IRibbonControl, ByRef returnedVal)
    returnedVal = inputFileName
End Sub

Sub uiGetInputDescription(control As IRibbonControl, ByRef returnedVal)
    Dim dictCount As Long
    
    If inputCompanySize = 1 Then
        inputCompanySizeText = CStr(inputCompanySize) & " person"
    Else
        inputCompanySizeText = CStr(inputCompanySize) & " people"
    End If
    
    'Mac-compatible Dictionary check - avoid IsEmpty on objects and short-circuit issues
    On Error Resume Next
    dictCount = 0
    dictCount = MyDictionaryPersonalInfo.Count
    On Error GoTo 0
    
    If dictCount > 0 Then
        On Error Resume Next
        returnedVal = "Input File: " & inputFileName & vbCr & _
                    "Sheet: " & inputSheetName & vbCr & _
                    "CEO Name: " & MyDictionaryPersonalInfo.Item(inputCEOFullName).FullName & vbCr & _
                    "Company Size: " & inputCompanySizeText
        If Err.Number <> 0 Then
            returnedVal = ""
            Err.Clear
        End If
        On Error GoTo 0
    Else
        returnedVal = ""
    End If
End Sub

