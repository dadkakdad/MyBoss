    getRibbon().InvalidateControl ("excelParametersBox")
    getRibbon().InvalidateControl ("uploadExcelFile")
    
    getRibbon().InvalidateControl ("inputFileName")
    getRibbon().InvalidateControl ("sheetName")
    getRibbon().InvalidateControl ("sheetHasTitles")
End Sub

'Callback for "Upload File" button
Sub uploadExcelFile(control As IRibbonControl)
    If StrComp(inputFilePath, "") <> 0 Then
        If sheetHasTitlesFlag Then
            inputFirstRow = 2
        Else
            inputFirstRow = 1
        End If
        
        #If Mac Then
            parameterString = CStr(Replace(inputFilePath, Chr(92), "/"))
            excelFileValidation = CStr(AppleScriptTask("MyBoss-browse_files_on_mac.scpt", "checkExcelExists", parameterString))
            
            If excelFileValidation = "success" Then
                parameterString = CStr(Replace(inputFilePath, Chr(92), "/") & "|" & inputSheetName)
                excelSheetValidation = CStr(AppleScriptTask("MyBoss-browse_files_on_mac.scpt", "checkSheetExists", parameterString))
                
                If excelSheetValidation = "success" Then
                    ReDim employeesList(defaultInputNumberOfColumns - 1, 0)
                    eRowNonEmptyCounter = 0
                    eOffset = 0
                    employeesListLength = 0
                    
                    parameterString = CStr(Replace(inputFilePath, Chr(92), "/") & "|" & inputSheetName & "|" & CStr(eOffset) & "|" & CStr(100))
                    excelSheetData = CStr(AppleScriptTask("MyBoss-browse_files_on_mac.scpt", "openExcelGetSheetData", parameterString))
                    
                    Do While Len(excelSheetData) > 0
                        ReDim Preserve employeesList(defaultInputNumberOfColumns - 1, UBound(employeesList, 2) + 100)
                        'Rows are split by ";", columns are split by "|"
                        excelSheetDataRows = Split(excelSheetData, ";")
                        
                        For Each eRow In excelSheetDataRows
                            If Len(eRow) > 0 Then
                                If eRowNonEmptyCounter >= inputFirstRow - 1 Then
                                    eCells = Split(eRow, "|")
                                    
                                    If UBound(eCells, 1) >= defaultInputNumberOfColumns Then
                                        For i = 0 To defaultInputNumberOfColumns - 1
                                            employeesList(i, employeesListLength) = Replace(Replace(eCells(i), vbLf, ""), vbCrLf, "")
                                        Next i
                                        employeesListLength = employeesListLength + 1
                                    Else
                                        GoTo askToCheckTheData
                                    End If
                                End If
                            End If
                            eRowNonEmptyCounter = eRowNonEmptyCounter + 1
                        Next eRow
                        
                        eOffset = eOffset + 100
                        parameterString = CStr(Replace(inputFilePath, Chr(92), "/") & "|" & inputSheetName & "|" & CStr(eOffset) & "|" & CStr(100))
                        excelSheetData = CStr(AppleScriptTask("MyBoss-browse_files_on_mac.scpt", "openExcelGetSheetData", parameterString))
                    Loop
                    
                    employeesList = wfTransposeArray(employeesList)
                Else
                    GoTo askToSelectAnotherSheet
                End If
            Else
                GoTo askToSelectAnotherFile
            End If
        #Else
            On Error GoTo askToSelectAnotherFile
            Set oXL = CreateObject("Excel.Application")
            Set oWB = oXL.Workbooks.Open(inputFilePath)
        
            ReDim employeesList(oWB.Worksheets(inputSheetName).UsedRange.Rows.Count - 1, defaultInputNumberOfColumns - 1)
    
            rangeExplicit = "A" & CStr(inputFirstRow) & ":" & Chr(Asc("A") + defaultInputNumberOfColumns - 1) & oWB.Worksheets(inputSheetName).UsedRange.Rows.Count
    
            employeesList = oWB.Worksheets(inputSheetName).Range(rangeExplicit).Value
            oWB.Close SaveChanges:=False
            oXL.Quit
        #End If

        If buildHierarchy() Then
            If checkConnectionsToCEO() Then
                Call openProgressBar("Calculating...", -1, False)
                'Firstly, pre-calculate all subordinates numbers to save time
                MyDictionaryPersonalInfo.Item(fullNameTopLevelManagerKey).HeadcountStats = CalculateSubordinates(fullNameTopLevelManagerKey, "number")
                    
                'Secondly, sort the list of Employees
                MyVariantListOfEmployees = MyDictionaryPersonalInfo.keys
                Call sortUtility(MyVariantListOfEmployees, 0, UBound(MyVariantListOfEmployees), "alphabet", False)
                    
                'Last thing - structure the employees
                Set MyDictionaryEmployeesPerCategory = New Dictionary
                MyDictionaryEmployeesPerCategory.add "CEO", getEmployeesListByCategory("CEO")
                MyDictionaryEmployeesPerCategory.add "Managers", getEmployeesListByCategory("Managers")
                MyDictionaryEmployeesPerCategory.add "AZ", getEmployeesListByCategory("AZ")
                For i = Asc("A") To Asc("Z")
                    MyDictionaryEmployeesPerCategory.add Chr(i), getEmployeesListByCategory(Chr(i))
                Next i
            
                Call closeProgressBar
                    
                inputCategoryName = "CEO"
                
                'Empty the editbox to start from scratch
                getRibbon().InvalidateControl ("refreshExcelFile")
                getRibbon().InvalidateControl ("personCategory")
                getRibbon().InvalidateControl ("personFullName")
                    
                Call disableUploadingStage
                Call enableCreationStage
            End If
        End If
    Else
        MsgBox ("You didn't specify input file")
    End If
    Exit Sub
        
askToSelectAnotherFile:
    Call disableCreationStage
    Call enableUploadingStage
    
    MsgBox ("Can't find this file: " & inputFileNmae & ". Please select it again or pick another one.")
    Call closeProgressBar
    Exit Sub

askToSelectAnotherSheet:
    Call disableCreationStage
    Call enableUploadingStage
            
    MsgBox ("Can't find this sheet: " & inputSheetName & ". Please select it again or pick another one.")
    Call closeProgressBar
    Exit Sub
    
askToCheckTheData:
    Call disableCreationStage
    Call enableUploadingStage
    
    MsgBox ("Please check you selected the right sheet: " & inputSheetName & ". It doesn't have enough columns for the template.")
    Call closeProgressBar
    Exit Sub

End Sub

