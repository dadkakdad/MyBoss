'Callback for "pick an Excel file"
Sub pickExcelFile(control As IRibbonControl)
    ' Open the file dialog, let user select Excel file
    inputFilePath = browseFile()
    
    If inputFilePath <> "" Then
        'Mac-compatible path parsing: handle both / and \ separators
        Dim pathSeparatorPos As Long
        Dim pathSeparator As String
        
        reversedInputFilePath = StrReverse(inputFilePath)
        
        #If Mac Then
            'Mac: paths might use / (POSIX) or \ (converted from HFS)
            'Find whichever separator appears first in the reversed string
            Dim backslashPos As Long, forwardslashPos As Long
            backslashPos = InStr(1, reversedInputFilePath, "\")
            forwardslashPos = InStr(1, reversedInputFilePath, "/")
            
            If backslashPos = 0 And forwardslashPos = 0 Then
                'No separator found - just use the whole path as filename
                inputFileName = inputFilePath
                pathSeparatorPos = 0
            ElseIf backslashPos = 0 Then
                pathSeparatorPos = forwardslashPos
            ElseIf forwardslashPos = 0 Then
                pathSeparatorPos = backslashPos
            Else
                'Both found - use whichever comes first (closest to end of original path)
                pathSeparatorPos = IIf(backslashPos < forwardslashPos, backslashPos, forwardslashPos)
            End If
            
            If pathSeparatorPos > 0 Then
                inputFileName = StrReverse(Left(reversedInputFilePath, pathSeparatorPos - 1))
            End If
        #Else
            'Windows: always use backslash
            pathSeparatorPos = InStr(1, reversedInputFilePath, "\")
            If pathSeparatorPos > 0 Then
                inputFileName = StrReverse(Left(reversedInputFilePath, pathSeparatorPos - 1))
            Else
                inputFileName = inputFilePath
            End If
        #End If
        
        inputFileExtension = StrReverse(Left(reversedInputFilePath, InStr(1, reversedInputFilePath, ".")))
        
        inputFileDirectory = Replace(inputFilePath, inputFileName, "")
        
        ' Check file's extension whether it is Excel file or not
        If LCase(inputFileExtension) = ".xls" Or LCase(inputFileExtension) = ".xlsx" Or LCase(inputFileExtension) = ".xlsm" Then
            getRibbon().InvalidateControl ("inputFileName")
            
            #If Mac Then
                Dim macPath As String
                macPath = Replace(inputFilePath, Chr(92), "/")
                
                Dim appleScriptResult As String
                appleScriptResult = CStr(AppleScriptTask("MyBoss-browse_files_on_mac.scpt", "openExcelGetSheets", macPath))
                
                Dim sheetsText As String
                sheetsText = textInBraces(appleScriptResult)
                
                'Remove trailing comma if present (AppleScript quirk)
                If Right(sheetsText, 1) = "," Then
                    sheetsText = Left(sheetsText, Len(sheetsText) - 1)
                End If
                
                worksheetNames = Split(sheetsText, ",")
                
                ReDim mCurrentSheet(0)
                ReDim MyVariantListOfSheets(UBound(worksheetNames))
                For i = 0 To UBound(worksheetNames)
                    MyVariantListOfSheets(i) = worksheetNames(i)
                Next i
            #Else
                Set oXL = CreateObject("Excel.Application")
                Set oWB = oXL.Workbooks.Open(inputFilePath)
                
                ReDim mCurrentSheet(0)
                ReDim MyVariantListOfSheets(oWB.Worksheets.Count - 1)
                For i = 1 To oWB.Worksheets.Count
                    MyVariantListOfSheets(i - 1) = oWB.Worksheets(i).Name
                Next i
                
                oWB.Close SaveChanges:=False
                oXL.Quit
            #End If
            
            getRibbon().InvalidateControl ("sheetName")
            
            'Hide interface and offer user to upload the file
            Call disableCreationStage
            Call enableUploadingStage
        Else
            MsgBox ("File can't be uploaded:" & vbCrLf & _
            "1. File extension should be either .xls OR .xlsm" & vbCrLf & _
            "2. Only latin letters can be used in file name")
            Exit Sub
        End If
    End If
End Sub

