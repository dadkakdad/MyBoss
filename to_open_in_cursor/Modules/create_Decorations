Sub addOneOfShades(control As IRibbonControl)
    slideNumber = ActiveWindow.Selection.SlideRange.slideIndex 'ActivePresentation.Windows(1).View.Slide.slideIndex
    
    'Copy + Paste shade
    tempTemplateName = "Shade" & CStr(shadeIterator + 1) & "Department"
    copiedShapeName = copyShapeErrorFree(tempTemplateName, slideNumber, tempTemplateName)
    
    'Send it to back to not cover org chart elements
    ActivePresentation.Slides(slideNumber).Shapes(copiedShapeName).Select
    ActiveWindow.Selection.ShapeRange.ZOrder msoSendToBack
    
    shadeIterator = (shadeIterator + 1) Mod defaultNumberOfShades
End Sub

Sub addEmptyCard(control As IRibbonControl)
    slideNumber = ActiveWindow.Selection.SlideRange.slideIndex 'ActivePresentation.Windows(1).View.Slide.slideIndex
    
    'Copy + Paste all 4 types of cards
    tempTemplateName = "Card" & "Ordinary" & inputBoxSize
    copiedShapeName = copyShapeErrorFree(tempTemplateName, slideNumber, tempTemplateName)
    
    tempTemplateName = "Card" & "Important" & inputBoxSize
    copiedShapeName = copyShapeErrorFree(tempTemplateName, slideNumber, tempTemplateName)
    
    tempTemplateName = "Card" & "OutSource" & inputBoxSize
    copiedShapeName = copyShapeErrorFree(tempTemplateName, slideNumber, tempTemplateName)
    
    tempTemplateName = "Card" & "Tbh" & inputBoxSize
    copiedShapeName = copyShapeErrorFree(tempTemplateName, slideNumber, tempTemplateName)
End Sub

Sub addLine(control As IRibbonControl)
    slideNumber = ActiveWindow.Selection.SlideRange.slideIndex 'ActivePresentation.Windows(1).View.Slide.slideIndex
    
    'Rnd is used to always get the unique ID of shape
    Call drawLineHorizontal(slideNumber, "connectorRandom" & CStr(Int((100 - 1 + 1) * Rnd + 1)), 100, 100, 100)
End Sub
